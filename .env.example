# Supabase project (Settings → API). The publishable/anon key is safe in the
# browser: row-level security is the access boundary. No service-role key is used.
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Optional server-side fallbacks, used if the VITE_ values aren't injected at runtime.
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Server-only. Powers AI question suggestions and response summaries.
ANTHROPIC_API_KEY=
